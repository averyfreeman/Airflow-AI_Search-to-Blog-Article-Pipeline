AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me
CODEX_RUNTIME=gateway
CODEX_GATEWAY_URL=http://host.docker.internal:8787
CODEX_GATEWAY_TOKEN_FILE_HOST=/Users/avery/.secrets/article-pipeline-codex-gateway-token
CODEX_GATEWAY_TOKEN_FILE=/run/secrets/codex_gateway_token
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=max
CODEX_LOCAL_FALLBACK=true
TAKEOUT_SOURCE=/workspace/content/data
TAKEOUT_AUTO_COPY=false
ARTICLE_PIPELINE_SELECTION=N
ARTICLE_PIPELINE_PILOT_N=10
